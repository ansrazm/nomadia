{
  "name": "Nomadia - order paid",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nomadia-order-paid",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook order.paid",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
