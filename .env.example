# Salin ke .env (jangan di-commit). Dipakai docker compose.
N8N_WEBHOOK_SECRET=ganti-dengan-string-acak-min-16-karakter

# Kredensial sandbox iPaymu (dashboard sandbox.ipaymu.com > Integrasi). Kosongkan untuk jalan tanpa pembayaran.
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_MODE=sandbox
IPAYMU_DEBUG=false
# redirect = halaman bayar iPaymu (default). qris = QRIS Direct: QR tampil di halaman pesanan.
# Hanya nilai awal: setelah diubah dari /admin/settings, pilihan di database yang berlaku.
IPAYMU_FLOW=redirect

# iPaymu harus bisa memanggil callback ke API kamu. Dari laptop, pakai tunnel dan isi URL publiknya di sini.
PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Tombol WhatsApp di pojok kanan bawah. Format internasional tanpa tanda +, mis. 6281234567890. Kosong = tombol disembunyikan.
# Nilai ini ikut tertanam saat build, jadi setelah diubah jalankan: docker compose up -d --build web
NEXT_PUBLIC_WHATSAPP_NUMBER=

# CMS admin (opsional; kosongkan ketiganya untuk menonaktifkan). AUTH_SECRET: `openssl rand -hex 32`
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=

# Login pelanggan tanpa kata sandi (opsional; kosong = fitur mati, checkout tamu tetap jalan). Kode 6 digit dikirim ke email pelanggan.
# CUSTOMER_AUTH_SECRET: `openssl rand -hex 32`, harus berbeda dari AUTH_SECRET. Di Docker Compose, SMTP sudah menunjuk Mailpit (http://localhost:8025).
CUSTOMER_AUTH_SECRET=
# Hanya diisi bila memakai SMTP sungguhan (mis. layanan email transaksional); kosongkan untuk memakai Mailpit bawaan compose.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nomadia <no-reply@nomadia.local>

# Pembatasan laju per IP untuk jalur publik (order 10 per 10 menit, quote 60 per menit, cek status 120 per menit). off = mati.
RATE_LIMIT=on
# Jumlah proxy tepercaya di depan API. 0 = IP dibaca dari koneksi TCP dan X-Forwarded-For diabaikan (aman dari pemalsuan).
# Di belakang Cloudflare Tunnel, Nginx, atau Caddy isi 1; bila 0, semua pengunjung dihitung sebagai satu IP dan berbagi jatah.
TRUST_PROXY_HOPS=0

# Notifikasi Telegram ke pemilik toko (opsional; kosongkan untuk melewati). Token dari @BotFather, chat id dari @userinfobot atau getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
