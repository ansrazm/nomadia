# Salin ke .env (jangan di-commit). Dipakai docker compose.
N8N_WEBHOOK_SECRET=ganti-dengan-string-acak-min-16-karakter

# Kredensial sandbox iPaymu (dashboard sandbox.ipaymu.com > Integrasi). Kosongkan untuk jalan tanpa pembayaran.
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_MODE=sandbox

# iPaymu harus bisa memanggil callback ke API kamu. Dari laptop, pakai tunnel dan isi URL publiknya di sini.
PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
