# ============================================================
# Nomadia — contoh environment. Salin jadi .env lalu isi nilainya:
#   cp env.example .env
# JANGAN commit file .env (sudah ada di .gitignore).
# ============================================================

# --- Umum ---
NODE_ENV=development
TZ=Asia/Jakarta

# --- Port layanan (docker compose) ---
WEB_PORT=3000
API_PORT=4000
N8N_PORT=5678

# --- URL publik (dipakai CORS, redirect pembayaran, dan callback) ---
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# Dipakai browser untuk memanggil API
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- PostgreSQL ---
POSTGRES_USER=nomadia
POSTGRES_PASSWORD=ganti-password-ini
POSTGRES_DB=nomadia
# Di dalam docker compose host-nya "db"; kalau jalan tanpa compose ganti ke localhost
DATABASE_URL=postgres://nomadia:ganti-password-ini@db:5432/nomadia

# --- Auth admin (CMS) ---
# Buat string acak panjang, contoh: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-panjang
# Akun admin awal yang dibuat oleh seed
ADMIN_EMAIL=admin@nomadia.local
ADMIN_PASSWORD=ganti-password-admin

# --- Payment gateway ---
# ipaymu = iPaymu sandbox, mock = simulasi tanpa kredensial (untuk demo/tes)
PAYMENT_PROVIDER=mock
# Kredensial iPaymu sandbox (dashboard sandbox iPaymu)
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_BASE_URL=https://sandbox.ipaymu.com/api/v2
# URL yang dipanggil iPaymu saat status bayar berubah. Harus bisa diakses dari internet,
# saat dev lokal isi dengan URL tunnel (Cloudflare Tunnel / ngrok), contoh: https://xxxx.trycloudflare.com/webhooks/ipaymu
IPAYMU_NOTIFY_URL=
IPAYMU_RETURN_URL=http://localhost:3000/checkout
IPAYMU_CANCEL_URL=http://localhost:3000/cart

# --- API eksternal (tanpa API key) ---
REST_COUNTRIES_URL=https://restcountries.com/v3.1
EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/IDR
# Lama cache data eksternal (detik)
EXTERNAL_CACHE_TTL=3600

# --- Automasi n8n ---
N8N_ENCRYPTION_KEY=ganti-dengan-string-acak
# URL n8n dari sisi API (di compose: nama service "n8n")
N8N_WEBHOOK_URL=http://n8n:5678/webhook/order-paid
# Secret bersama untuk HMAC-SHA256 antara API dan n8n
N8N_WEBHOOK_SECRET=ganti-dengan-string-acak

# --- Notifikasi Telegram (dipakai workflow n8n) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Opsional: ringkasan order pakai LLM di n8n ---
ANTHROPIC_API_KEY=
