{
  "kind": "collectionType",
  "collectionName": "faqs",
  "info": { "singularName": "faq", "pluralName": "faqs", "displayName": "FAQ", "description": "Pertanyaan umum" },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
