    "dev:va-probe": "tsx src/dev/va-probe.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "dotenv": "^16.6.1",
    "hono": "^4.6.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
