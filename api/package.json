{
  "name": "nomadia-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "n8n:send": "tsx src/dev/n8n-send.ts",
    "dev:mark-paid": "tsx src/dev/mark-paid.ts",
