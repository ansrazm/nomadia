# Salin ke .env lalu isi. File .env tidak boleh di-commit.
PORT=4000
DATABASE_URL=postgres://nomadia:nomadia@localhost:5432/nomadia
# Asal frontend yang boleh memanggil API (pisahkan koma bila lebih dari satu)
CORS_ORIGINS=http://localhost:3000

# Alamat publik API (untuk notifyUrl iPaymu) dan frontend (returnUrl/cancelUrl)
PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# iPaymu sandbox. Kosongkan keduanya untuk mode tanpa pembayaran (paymentUrl = null).
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_MODE=sandbox
IPAYMU_DEBUG=false

# n8n: event order.paid dikirim ke URL ini, ditandatangani HMAC dengan secret (min 16 karakter). Isi keduanya atau kosongkan keduanya.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# CMS admin. Isi ketiganya atau kosongkan ketiganya (kosong = endpoint /admin mati).
# AUTH_SECRET: string acak min 32 karakter, mis. `openssl rand -hex 32`. Mengganti nilainya mencabut semua sesi login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=
