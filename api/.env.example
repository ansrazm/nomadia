# Salin ke .env lalu isi. File .env tidak boleh di-commit.
PORT=4000
DATABASE_URL=postgres://nomadia:nomadia@localhost:5432/nomadia
# Asal frontend yang boleh memanggil API (pisahkan koma bila lebih dari satu)
# Pisahkan koma bila web berjalan di lebih dari satu asal, mis. http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# Alamat publik API (untuk notifyUrl iPaymu) dan frontend (returnUrl/cancelUrl)
PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# iPaymu sandbox. Kosongkan keduanya untuk mode tanpa pembayaran (paymentUrl = null).
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_MODE=sandbox
IPAYMU_DEBUG=false
# redirect = halaman bayar iPaymu (default). qris = QRIS Direct: QR tampil di halaman pesanan.
# Hanya nilai awal: setelah diubah dari /admin/settings, pilihan di database yang berlaku.
IPAYMU_FLOW=redirect

# n8n: event order.paid dikirim ke URL ini, ditandatangani HMAC dengan secret (min 16 karakter). Isi keduanya atau kosongkan keduanya.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# CMS admin. Isi ketiganya atau kosongkan ketiganya (kosong = endpoint /admin mati).
# AUTH_SECRET: string acak min 32 karakter, mis. `openssl rand -hex 32`. Mengganti nilainya mencabut semua sesi login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=

# Asisten chat AI (opsional; kosong = panel chat memakai FAQ statis). Kunci hanya dibaca server, tidak pernah dikirim ke browser.
# LLM_PROVIDER: anthropic (bawaan) atau openai (endpoint /chat/completions; juga Groq, OpenRouter, Gemini, Ollama lewat LLM_BASE_URL).
# LLM_MODEL boleh kosong untuk anthropic (bawaan claude-haiku-5-5); wajib untuk openai.
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
# Batas total panggilan chat per jam untuk seluruh server (per IP: 20 per 10 menit). Menjaga tagihan model.
CHAT_GLOBAL_PER_HOUR=300

# Pembatasan laju per IP untuk jalur publik (order 10 per 10 menit, quote 60 per menit, cek status 120 per menit). off = mati.
RATE_LIMIT=on
# Jumlah proxy tepercaya di depan API. 0 = IP dibaca dari koneksi TCP dan X-Forwarded-For diabaikan (aman dari pemalsuan).
# Di belakang Cloudflare Tunnel, Nginx, atau Caddy isi 1; bila 0, semua pengunjung dihitung sebagai satu IP dan berbagi jatah.
TRUST_PROXY_HOPS=0
