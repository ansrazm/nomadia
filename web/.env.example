# Alamat backend (wajib diisi; harga, voucher, dan pesanan semuanya dari API).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Alamat API untuk server Next.js (membaca katalog saat request). Kosongkan untuk memakai NEXT_PUBLIC_API_URL.
# Di Docker Compose diisi otomatis menjadi http://api:4000.
API_INTERNAL_URL=

# Nomor WhatsApp untuk tombol chat (format internasional tanpa +, mis. 6281234567890). Kosong = tombol WhatsApp disembunyikan.
NEXT_PUBLIC_WHATSAPP_NUMBER=
